<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Priya Satpute — Aspiring Product Manager with 14+ years in banking and credit.">
<title>Priya Satpute — Product & Banking</title>
<style>
:root{
  --bg:#f5f5f7;--card:#fff;--text:#1d1d1f;--muted:#6e6e73;
  --line:#d2d2d7;--blue:#0071e3;--dark:#111113;
  --radius:28px;--shadow:0 18px 50px rgba(0,0,0,.08);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",
  "Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  line-height:1.45;-webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none}
.container{width:min(1120px,calc(100% - 40px));margin:auto}
.nav{
  position:sticky;top:0;z-index:20;
  background:rgba(245,245,247,.82);backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(0,0,0,.06);
}
.nav-inner{height:58px;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:700;letter-spacing:-.02em}
.nav-links{display:flex;gap:26px;font-size:14px;color:#424245}
.nav-links a:hover{color:var(--blue)}
.hero{padding:110px 0 90px}
.eyebrow{font-size:15px;font-weight:600;color:var(--blue);margin-bottom:18px}
h1{
  font-size:clamp(48px,8vw,88px);line-height:.98;
  letter-spacing:-.065em;margin:0;max-width:900px;font-weight:700;
}
.hero h1 span{color:var(--muted)}
.hero-copy{
  font-size:clamp(20px,2.6vw,28px);line-height:1.25;
  letter-spacing:-.025em;color:#424245;max-width:790px;margin:30px 0;
}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:13px 21px;border-radius:999px;font-size:15px;font-weight:600;
  transition:.2s ease;cursor:pointer;border:1px solid transparent;
}
.btn.primary{background:var(--blue);color:#fff}
.btn.primary:hover{background:#0077ed;transform:translateY(-1px)}
.btn.secondary{background:transparent;border-color:var(--line)}
.btn.secondary:hover{background:#fff}
.section{padding:75px 0}
.section-title{font-size:14px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:700;margin-bottom:22px}
.intro-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:55px;align-items:start}
.large-copy{font-size:clamp(28px,4vw,45px);line-height:1.08;letter-spacing:-.045em;margin:0}
.side-copy{font-size:17px;color:#515154;margin:0}
.stats{
  margin-top:45px;display:grid;grid-template-columns:repeat(3,1fr);
  background:var(--dark);color:#fff;border-radius:var(--radius);overflow:hidden;
}
.stat{padding:32px;border-right:1px solid rgba(255,255,255,.14)}
.stat:last-child{border:0}
.stat-number{font-size:38px;letter-spacing:-.04em;font-weight:700}
.stat-label{color:#a1a1a6;margin-top:5px;font-size:14px}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.card{
  background:var(--card);border-radius:var(--radius);padding:32px;
  box-shadow:var(--shadow);min-height:245px;
}
.card .icon{
  width:45px;height:45px;border-radius:14px;background:#f2f2f7;
  display:grid;place-items:center;font-size:21px;margin-bottom:28px;
}
.card h3{font-size:24px;letter-spacing:-.025em;margin:0 0 9px}
.card p{color:var(--muted);margin:0;font-size:16px}
.experience{
  background:#fff;border-radius:36px;padding:45px;
  box-shadow:var(--shadow)
}
.role-top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
.company{font-size:32px;letter-spacing:-.035em;font-weight:700}
.role{color:var(--blue);font-weight:600;margin-top:4px}
.date{color:var(--muted);font-size:14px;text-align:right}
.location{color:var(--muted);font-size:14px;margin-top:4px}
.experience ul{margin:35px 0 0;padding:0;list-style:none;display:grid;gap:17px}
.experience li{display:grid;grid-template-columns:10px 1fr;gap:15px;color:#424245}
.experience li:before{content:"";width:7px;height:7px;background:var(--blue);border-radius:50%;margin-top:9px}
.focus{
  margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px
}
.focus-item{background:#fff;border-radius:22px;padding:24px;border:1px solid #e5e5e7}
.focus-item strong{display:block;font-size:16px;margin-bottom:6px}
.focus-item span{font-size:14px;color:var(--muted)}
.cta{
  margin:40px 0 75px;background:var(--dark);color:#fff;border-radius:36px;
  padding:65px;display:flex;align-items:center;justify-content:space-between;gap:35px
}
.cta h2{font-size:clamp(35px,5vw,58px);line-height:1;letter-spacing:-.05em;margin:0;max-width:680px}
.cta p{color:#a1a1a6;margin:16px 0 0;font-size:17px}
.cta .btn{background:#fff;color:#111}
.footer{padding:25px 0 45px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between;gap:20px}
@media(max-width:800px){
  .nav-links{display:none}
  .hero{padding:75px 0 65px}
  .intro-grid{grid-template-columns:1fr;gap:25px}
  .stats,.cards,.focus{grid-template-columns:1fr}
  .stat{border-right:0;border-bottom:1px solid rgba(255,255,255,.14)}
  .card{min-height:auto}
  .experience{padding:30px}
  .role-top{display:block}
  .date{text-align:left;margin-top:10px}
  .cta{padding:40px 30px;display:block}
  .cta .btn{margin-top:25px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</head>

